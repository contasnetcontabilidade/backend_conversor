# Chave da API Gemini (obrigatoria para o resumo)
GEMINI_API_KEY=

# Porta do backend
PORT=3000

# Caminho padrao de audio (relativo a pasta backend)
DEFAULT_AUDIO_FILE=audio_reuniao.WAV

# Modelo padrao do Whisper
WHISPER_MODEL=base

# Provider de transcricao: whisper | gemini
TRANSCRICAO_PROVIDER=

# Modelo padrao do Gemini para transcricao de audio
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Modelos fallback separados por virgula (tentados quando houver indisponibilidade)
GEMINI_TRANSCRIPTION_FALLBACK_MODELS=gemini-2.5-flash-lite

# Retries para indisponibilidade temporaria da Gemini
GEMINI_TRANSCRIPTION_RETRY_ATTEMPTS=4
GEMINI_TRANSCRIPTION_RETRY_BASE_DELAY_MS=800

# Modelo padrao do Gemini
GEMINI_MODEL=gemini-2.5-flash

# Pasta de uploads (relativa a pasta backend)
UPLOAD_DIR=uploads

# ===== Integracao GoTo Connect =====
# Credenciais do app criado em developer.goto.com
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
# Redirect URI cadastrada no app GoTo (deve bater exatamente)
GOTO_REDIRECT_URI=https://backend-conversor.vercel.app/api/goto/oauth/callback
# Base publica do backend (para montar a URL do webhook)
GOTO_PUBLIC_BASE=https://backend-conversor.vercel.app
# Refresh token do super-admin (evita o fluxo interativo de OAuth)
GOTO_REFRESH_TOKEN=
# Token secreto que compoe a URL do webhook (gere um valor aleatorio longo)
GOTO_WEBHOOK_TOKEN=
# Opcional: accountKey do super-admin (se nao resolver via /me automaticamente)
GOTO_ACCOUNT_KEY=
# Opcional: apelido do canal de notificacao
GOTO_CHANNEL_NICKNAME=conversor-call-events

# ===== Storage (Upstash Redis / Vercel KV) =====
# Aceita os nomes do Upstash OU os da integracao KV da Vercel (KV_REST_API_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ===== Ably (push em tempo real por ramal) =====
# Root key do Ably (fica SO no backend; apps usam token temporario via /goto/ably-token)
ABLY_API_KEY=

# ===== Painel admin de custos de IA =====
# Senha do painel /admin (padrao: Contas@2074 se nao definida)
ADMIN_PASSWORD=
# Cambio USD->BRL de fallback (usado se a cotacao online falhar)
GEMINI_USD_BRL=5.40
