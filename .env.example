# =============================================================================
#  backend_conversor - .env de exemplo
# =============================================================================
#  Copie para ".env" e preencha. NENHUM valor real deve ser commitado.
#  Em producao (Vercel) estas mesmas chaves sao configuradas em
#  Project Settings > Environment Variables (NAO no arquivo).
#  A explicacao completa de cada chave esta em DOCS.md > "Variaveis de ambiente".
# =============================================================================

# ===== IA / Gemini (transcricao + resumo) ===================================
# Chave da API Gemini (obrigatoria para transcricao via Gemini e para o resumo).
# GOOGLE_API_KEY funciona como alias de fallback se GEMINI_API_KEY estiver vazia.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Modelo padrao do Gemini para o RESUMO
GEMINI_MODEL=gemini-2.5-flash
# Modelo do Gemini para a TRANSCRICAO de audio (padrao: 2.5-pro, melhor com nomes)
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-pro
# Modelos de fallback (separados por virgula) tentados se o primeiro indisponivel
GEMINI_TRANSCRIPTION_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Retries para indisponibilidade temporaria da Gemini na transcricao
GEMINI_TRANSCRIPTION_RETRY_ATTEMPTS=4
GEMINI_TRANSCRIPTION_RETRY_BASE_DELAY_MS=800
# Controle de custo do "thinking" (raciocinio) do Gemini:
#  - GEMINI_THINKING_LEVEL: usado pelos modelos Gemini 3 (nao da pra desligar; min "low")
#  - GEMINI_THINKING_BUDGET: usado pelos modelos 2.x/1.5 (0 = desliga o thinking)
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0
# Budget de thinking para o gemini-2.5-pro (nao aceita 0; minimo valido 128)
GEMINI_THINKING_BUDGET_PRO=128
# Cambio USD->BRL de fallback (usado no painel /admin se a cotacao online falhar)
GEMINI_USD_BRL=5.40

# ===== Transcricao / Whisper local ==========================================
# Provider de transcricao: whisper | gemini.
# Se VAZIO: usa Gemini quando roda na Vercel (VERCEL setado), senao Whisper local.
TRANSCRICAO_PROVIDER=
# Modelo do Whisper local (nodejs-whisper)
WHISPER_MODEL=base
# Nome de arquivo de audio padrao quando nenhum e informado
DEFAULT_AUDIO_FILE=audio_reuniao.WAV
# Pasta de uploads (absoluta, ou relativa a raiz do backend). Fallback: tmp do SO.
UPLOAD_DIR=uploads

# ===== Servidor =============================================================
# Porta HTTP local (na Vercel e ignorado)
PORT=3000

# ===== Integracao GoTo Connect ==============================================
# Credenciais do app criado em developer.goto.com
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
# Redirect URI cadastrada no app GoTo (deve bater EXATAMENTE)
GOTO_REDIRECT_URI=https://backend-conversor.vercel.app/api/goto/oauth/callback
# Base publica do backend (usada para montar a URL do webhook)
GOTO_PUBLIC_BASE=https://backend-conversor.vercel.app
# Token secreto que compoe a URL do webhook/setup (gere um valor aleatorio longo).
# Se VAZIO, os endpoints /goto/webhook e /goto/setup respondem 404 (ficam desativados).
GOTO_WEBHOOK_TOKEN=
# Refresh token do super-admin (semente; evita refazer o OAuth interativo)
GOTO_REFRESH_TOKEN=
# Opcional: accountKey do super-admin (se nao, e resolvido via /me e cacheado)
GOTO_ACCOUNT_KEY=
# Opcional: apelido do canal de notificacao
GOTO_CHANNEL_NICKNAME=conversor-call-events
# Opcionais (raramente alterados): bases das APIs GoTo e "state" fixo do OAuth
GOTO_AUTH_BASE=https://authentication.logmeininc.com
GOTO_API_BASE=https://api.goto.com
GOTO_OAUTH_STATE=

# ===== Storage (Upstash Redis / Vercel KV) ==================================
# Aceita os nomes do Upstash OU os da integracao KV da Vercel (KV_REST_API_*).
# Sem storage o backend cai em memoria volatil (NAO persiste entre invocacoes
# serverless) - obrigatorio em producao para tokens GoTo, fila de eventos e idempotencia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ===== Ably (push em tempo real por ramal) ==================================
# Root key do Ably (fica SO no backend; os apps recebem token temporario
# escopado via GET /goto/ably-token). Se vazia, o push realtime e desativado.
ABLY_API_KEY=

# ===== Painel admin de custos de IA =========================================
# Senha do painel /admin (ATENCAO: se vazia, usa o padrao embutido "Contas@2074")
ADMIN_PASSWORD=

# ===== Autenticacao do app (token compartilhado, sem login) =================
# Se definido, o backend exige o header "x-app-token" igual a este valor em todas
# as rotas (exceto webhook/oauth/setup/admin/health). Deixe VAZIO para manter aberto
# (dev/teste). No go-live, defina o MESMO valor aqui (Vercel) e no build do desktop
# (DESKTOP_API_TOKEN) - e so DEPOIS que todas as maquinas ja atualizaram.
API_AUTH_TOKEN=

# ===== Suite360 / SuiteWeb (criacao de chamados) ============================
# Base da API Publica v1 (producao). Para o Suite DEV: http://10.10.1.183/api/public/v1
SUITE360_BASE_URL=https://suiteweb.contasnet.com.br/api/public/v1
# Chave da API (aceita tambem SUITEWEB_API_KEY como fallback). DEV e PROD tem chaves diferentes.
SUITE360_API_KEY=
SUITEWEB_API_KEY=
# Envio do POST /chamados: 1 = simula (dry-run), 0 = cria de verdade. Padrao: 1 (ligado).
SUITE360_DRY_RUN=1
# IDs FIXOS do chamado (se vazios, o backend resolve por lookup a partir da ligacao)
SUITE360_TIPO_APONTAMENTO_ID=
SUITE360_ORIGEM_ID=
SUITE360_SETOR_ID=
SUITE360_EXECUTOR_ID=
# Cliente padrao das ligacoes INTERNAS (o proprio escritorio). Se vazio, o backend
# resolve pelo CNPJ da CONTAS Servicos Contabeis (04.248.189/0001-97), com o id 1717
# (dev) como ultimo recurso. Em PRODUCAO, prefira setar aqui o id do cliente do escritorio.
SUITE360_CLIENTE_INTERNO_ID=
# Dicas para o lookup automatico quando os IDs acima estao vazios
SUITE360_SETOR_NOME=
SUITE360_EXECUTOR_Q=
# Aliases extras "departamento do GoTo = Setor do Suite" (pares separados por ; ou nova linha).
# Ex.: SUITE360_SETOR_ALIASES=cobranca=Financeiro;juridico=Regularizacao Fiscal
SUITE360_SETOR_ALIASES=

# ===== Integracao Gmail (chamados a partir de e-mails) ======================
# App OAuth criado no Google Cloud (APIs & Services > Credentials), com a Gmail API
# ATIVADA e a tela de consentimento como "Interno" (Workspace contas.com.br).
# Tipo do cliente OAuth: "Aplicativo da Web".
GMAIL_CLIENT_ID=            # Client ID do OAuth do Google
GMAIL_CLIENT_SECRET=        # Client secret do OAuth do Google (SEGREDO)
# URL de callback registrada no cliente OAuth (deve bater EXATAMENTE):
GMAIL_REDIRECT_URI=https://backend-conversor.vercel.app/api/gmail/oauth/callback
# Nome do MARCADOR do Gmail que dispara o chamado (o mesmo que a pessoa aplica no e-mail):
GMAIL_LABEL=Chamado
# --- Opcionais (tem default no codigo; raramente mudam) ---
GMAIL_AUTH_BASE=https://accounts.google.com/o/oauth2/v2/auth   # endpoint de authorize
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token            # endpoint de token
GMAIL_OAUTH_STATE=          # state fixo; se vazio, gera um UUID por login
